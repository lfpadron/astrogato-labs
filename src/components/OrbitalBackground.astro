---
interface Props { class?: string }
const { class: className } = Astro.props;
---
<div class:list={['orbital-background', className]} aria-hidden="true">
  <div class="orbit orbit-one"><i></i></div>
  <div class="orbit orbit-two"><i></i></div>
  <div class="orbit orbit-three"><i></i></div>
  <span class="orbit-axis axis-horizontal"></span>
  <span class="orbit-axis axis-vertical"></span>
</div>
