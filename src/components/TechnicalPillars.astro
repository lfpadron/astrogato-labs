---
import Icon from './Icon.astro';
import { getDictionary, type Locale } from '../i18n';
interface Props { locale: Locale }
const t = getDictionary(Astro.props.locale).pillars;
---
<section class="section pillars" aria-labelledby="pillars-title">
  <div class="container">
    <div class="section-intro split-intro"><div><p class="eyebrow">{t.eyebrow}</p><h2 id="pillars-title">{t.title}</h2></div><p class="section-description">{t.intro}</p></div>
    <div class="pillars-grid">{t.items.map((item) => <article class="pillar-card"><Icon name={item.icon} /><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div>
  </div>
</section>
