---
import Icon from './Icon.astro';
import { getDictionary, type Locale } from '../i18n';
interface Props { locale: Locale }
const t = getDictionary(Astro.props.locale).closing;
---
<section class="section closing dark-section" id="contact" aria-labelledby="closing-title">
  <div class="container closing-inner">
    <span class="closing-star" aria-hidden="true">✳</span>
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="closing-title">{t.title}</h2>
    <p>{t.description}</p>
    <a class="button button-primary" href="mailto:lfpadron@astrogatolabs.com">{t.cta}<Icon name="arrow" /></a>
  </div>
</section>
