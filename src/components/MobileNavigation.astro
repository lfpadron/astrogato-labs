---
import { getDictionary, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDictionary(locale);
---
<details class="mobile-navigation" data-mobile-navigation>
  <summary aria-controls="mobile-links"><span class="menu-lines" aria-hidden="true"></span>{t.a11y.menu}</summary>
  <nav id="mobile-links" aria-label={t.a11y.navigation}>
    <a href="#philosophy">{t.nav.philosophy}</a>
    <a href="#difference">{t.nav.differences}</a>
    <a href="#missions">{t.nav.missions}</a>
    <a href="#contact">{t.nav.contact}</a>
  </nav>
</details>
