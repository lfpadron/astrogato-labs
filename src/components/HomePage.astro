---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Philosophy from './Philosophy.astro';
import Differentiators from './Differentiators.astro';
import TechnicalPillars from './TechnicalPillars.astro';
import MissionSection from './MissionSection.astro';
import ClosingMessage from './ClosingMessage.astro';
import Footer from './Footer.astro';
import type { Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<BaseLayout locale={locale}>
  <Header locale={locale} />
  <main id="main" tabindex="-1">
    <Hero locale={locale} />
    <Philosophy locale={locale} />
    <Differentiators locale={locale} />
    <TechnicalPillars locale={locale} />
    <MissionSection locale={locale} category="upcoming" />
    <MissionSection locale={locale} category="demonstration" />
    <ClosingMessage locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
