---
import Icon from './Icon.astro';
import { getDictionary, type Locale } from '../i18n';
interface Props { locale: Locale }
const t = getDictionary(Astro.props.locale).differences;
---
<section class="section differences dark-section" id="difference" aria-labelledby="difference-title">
  <div class="container">
    <div class="section-intro"><p class="eyebrow">{t.eyebrow}</p><h2 id="difference-title">{t.title}</h2><p class="section-description">{t.intro}</p></div>
    <div class="difference-grid">
      {t.items.map((item) => <article class="difference-card"><div class="icon-box"><Icon name={item.icon} /></div><h3>{item.title}</h3><p>{item.description}</p></article>)}
    </div>
  </div>
</section>
